depends: [
  "ocaml"
  "uuidm"
  "dune" {>= "2.9"}
  "csexp"
  "ppx_deriving"
  "ppx_inline_test"
  "parsexp"
  "ounit2"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
